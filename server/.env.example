# Copia este archivo como ".env" y completa con tus datos reales.
# El servidor lo lee automáticamente al arrancar (server/.env).

# ---------- Correo (SMTP real) ----------
# Gmail (recomendado): activa la verificación en 2 pasos y crea una
# "Contraseña de aplicación" en https://myaccount.google.com/apppasswords
# y usa esa clave de 16 letras aquí (NO tu contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion

# Remitente que verán los usuarios. En Gmail debe ser igual a SMTP_USER.
MAIL_FROM=Haz Tu Camino <tucorreo@gmail.com>

# URL pública del cliente para armar los enlaces de los correos.
# En local deja http://localhost:5173 ; en producción pon tu dominio (sin barra final).
# Ejemplo en Render: APP_URL=https://haztucamino-proyecto-1.onrender.com
APP_URL=http://localhost:5173

# ---------- Panel de administración (/admin) ----------
# Credenciales para entrar al panel administrativo (NO enlazado en la web).
ADMIN_EMAIL=admin@tucorreo.com
ADMIN_PASSWORD=cambia_esta_contrasena
