# Copia este archivo como ".env" y completa con tus datos reales.
# El servidor lo lee automáticamente al arrancar (server/.env).

# ---------- Correo (recomendado: API por HTTPS) ----------
# En Render (plan gratis) los puertos SMTP 25/465/587 están BLOQUEADOS, así que
# el envío por SMTP no llega. Usa una API por HTTPS (puerto 443): basta con
# definir UNA de estas claves y el mailer la usará automáticamente.
#
# Brevo (gratis 300 correos/día, solo verifica tu correo remitente):
#   1) crea cuenta en https://brevo.com
#   2) "Senders" → agrega y verifica tu correo remitente (igual a MAIL_FROM)
#   3) "SMTP & API" → API Keys → crea una clave
BREVO_API_KEY=
#
# Resend (requiere verificar un dominio propio):
#   1) crea cuenta en https://resend.com
#   2) verifica tu dominio y usa un remitente de ese dominio en MAIL_FROM
RESEND_API_KEY=

# Remitente que verán los usuarios. Con Brevo debe ser el correo que verificaste.
MAIL_FROM=Haz Tu Camino <tucorreo@gmail.com>

# ---------- Correo (SMTP de respaldo; no funciona en Render gratis) ----------
# Gmail: activa la verificación en 2 pasos, crea una "Contraseña de aplicación"
# en https://myaccount.google.com/apppasswords y usa esa clave de 16 letras.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion

# URL pública del FRONTEND (donde el usuario usa la web). Se usa para armar los
# enlaces de los correos (confirmar cuenta / restablecer contraseña).
# IMPORTANTE: si tu frontend está en otro dominio que el API (p. ej. una Static
# Site aparte), pon aquí ESA URL. Si no lo defines, se usa el host de la petición.
# En Render: p. ej. APP_URL=https://haztucamino.onrender.com  (sin barra final)
APP_URL=http://localhost:5173

# HTC_SECRET: clave para firmar tokens de sesión/admin. Define una aleatoria en
# producción (si no, se usa una por defecto que es pública en el repositorio).
HTC_SECRET=

# ---------- Panel de administración (/admin) ----------
# Credenciales para entrar al panel administrativo (NO enlazado en la web).
ADMIN_EMAIL=admin@tucorreo.com
ADMIN_PASSWORD=cambia_esta_contrasena
